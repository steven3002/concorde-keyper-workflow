# Live deployment environment variables template.
# Copy to .env and supply actual credentials for live runs.

# Model provider endpoint and API key
MODEL_UPSTREAM_ORIGIN=https://api.openai.com
MODEL_UPSTREAM_KEY=

# Telegram bot token and authorized chat ID for status queries
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# Grafana metrics upstream
METRICS_UPSTREAM_ORIGIN=https://grafana.metrics.shutter.network

# PostgreSQL credentials
POSTGRES_USER=concorde
POSTGRES_PASSWORD=
POSTGRES_DB=concorde
